[Unit]
Description=Review RU restricted route candidate without applying
After=bird.service
Wants=bird.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/ru-restricted-routes
ExecStart=/usr/bin/python3 -m ru_routes.review --state-dir /var/lib/ru-restricted-routes
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/run/lock
ProtectHome=true
PrivateTmp=true
